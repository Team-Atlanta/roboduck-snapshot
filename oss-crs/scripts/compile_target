#!/bin/bash
# Build-phase entry point: compile the target and submit build + src outputs.
# Produces three builds: primary (asan), coverage, and debug.
set -e

# Save original environment
ORIG_OUT="$OUT"
ORIG_SANITIZER="${SANITIZER:-address}"
ORIG_CFLAGS="${CFLAGS:-}"
ORIG_CXXFLAGS="${CXXFLAGS:-}"
ORIG_FUZZING_ENGINE="${FUZZING_ENGINE:-libfuzzer}"

###############################################################################
# 1. Primary build (default sanitizer) — wrapped with bear to capture
#    compile_commands.json for infer static analysis
###############################################################################
if command -v bear >/dev/null 2>&1; then
    echo "[compile_target] Running primary build with bear..."
    # bear 2.x syntax: no '--' separator
    bear -o "$SRC/compile_commands.json" compile || compile
else
    compile
fi
libCRS submit-build-output "$OUT" build

# Submit source tree (now includes compile_commands.json from bear)
libCRS submit-build-output "$SRC" src

###############################################################################
# Helper: clean build caches (CMake, autotools, etc.) between variant builds
###############################################################################
_clean_build_cache() {
    # CMake caches
    find "$SRC" -maxdepth 3 \( -name CMakeCache.txt -o -name CMakeFiles -o -name build \) \
        -exec rm -rf {} + 2>/dev/null || true
    # Autotools caches
    find "$SRC" -maxdepth 3 -name config.cache -delete 2>/dev/null || true
}

###############################################################################
# 2. Coverage build — compile with coverage instrumentation
#    Enables llvm-cov based code coverage analysis in the CRS.
###############################################################################
echo "[compile_target] Building coverage variant..."
_clean_build_cache
export OUT=/out-coverage
mkdir -p "$OUT"
export SANITIZER=coverage
export CFLAGS="$ORIG_CFLAGS -fno-inline"
export CXXFLAGS="$ORIG_CXXFLAGS -fno-inline"
export FUZZING_ENGINE="$ORIG_FUZZING_ENGINE"

if compile 2>&1; then
    libCRS submit-build-output "$OUT" coverage-build
    echo "[compile_target] Coverage build submitted."
else
    echo "[compile_target] WARNING: Coverage build failed, skipping."
fi

###############################################################################
# 3. Debug build — compile with debug symbols, no fuzzing engine
#    Enables GDB-based debugging and analysis in the CRS.
###############################################################################
echo "[compile_target] Building debug variant..."
_clean_build_cache
export OUT=/out-debug
mkdir -p "$OUT"
export SANITIZER="$ORIG_SANITIZER"
export CFLAGS="$ORIG_CFLAGS -ggdb -fno-inline"
export CXXFLAGS="$ORIG_CXXFLAGS -ggdb -fno-inline"
export FUZZING_ENGINE=none

if compile 2>&1; then
    libCRS submit-build-output "$OUT" debug-build
    echo "[compile_target] Debug build submitted."
else
    echo "[compile_target] WARNING: Debug build failed, skipping."
fi
